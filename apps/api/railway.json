{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install && pnpm turbo run build --filter=@financeiro/api",
    "watchPatterns": ["apps/api/**", "packages/**", "pnpm-lock.yaml", "turbo.json"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @financeiro/api start:prod",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
