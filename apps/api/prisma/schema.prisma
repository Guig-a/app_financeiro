// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Enums espelhados na API (DTOs) onde necessário.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER
  USER
}

enum TipoPessoa {
  CLIENTE
  FORNECEDOR
  AMBOS
}

enum TipoLancamento {
  RECEITA
  DESPESA
}

enum UnidadeProduto {
  KG
  UN
  CAIXA
  FARDO
}

model User {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String         @unique
  passwordHash  String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]

  @@index([tenantId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenId   String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenId])
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  cpf       String?  @unique
  cnpj      String?  @unique
  createdAt DateTime @default(now())
  users     User[]
  pessoas   Pessoa[]
  produtos  Produto[]
  lancamentos Lancamento[]
}

model Pessoa {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome      String
  tipo      TipoPessoa
  documento String?
  createdAt DateTime @default(now())
  lancamentos Lancamento[]

  @@index([tenantId])
  @@unique([tenantId, documento])
}

model Produto {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome      String
  codigo    String?
  unidade   UnidadeProduto?
  preco     Decimal? @db.Decimal(15, 2)
  createdAt DateTime @default(now())
  lancamentos Lancamento[]

  @@index([tenantId])
  @@unique([tenantId, codigo])
}

model Lancamento {
  id              String          @id @default(uuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  descricao       String?
  pessoaId        String?
  pessoa          Pessoa?         @relation(fields: [pessoaId], references: [id], onDelete: Restrict)
  produtoId       String?
  produto         Produto?        @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  valor           Decimal         @db.Decimal(15, 2)
  dataCompetencia DateTime
  dataVencimento  DateTime
  dataQuitacao    DateTime?
  tipo            TipoLancamento
  createdAt       DateTime        @default(now())

  @@index([tenantId])
  @@index([tenantId, dataVencimento])
  @@index([tenantId, dataCompetencia])
}
