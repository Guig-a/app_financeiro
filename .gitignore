# compiled output
/dist
/build
**/dist
**/.next
**/node_modules
**/out

# Turborepo — cache local (não versionar; evita ficheiros >50MB no GitHub)
.turbo
**/.turbo

# Caches de ferramentas (ESLint, bundlers, etc.)
.eslintcache
**/.eslintcache
**/.cache
.swc
**/.swc

# TypeScript incremental (além do que cada app já ignora)
*.tsbuildinfo

# Storybook (se passarem a usar)
storybook-static
**/storybook-static

# SQLite de testes E2E (`pnpm test:e2e` na raiz)
/test-e2e.db
/test-e2e.db-journal

# SQLite genérico local (além de **/prisma/*.db)
*.sqlite
*.sqlite3

# Prisma generated client (rode `npx prisma generate` após clone)
**/prisma/generated

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Tests
/coverage
/.nyc_output
**/coverage

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.*
.env.development.local
.env.test.local
.env.production.local
.env.local

# local SQLite databases
**/prisma/*.db
**/prisma/*.db-journal

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
